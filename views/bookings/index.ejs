<%- include('../header') %>
    <h2 class="mb-4">Booking Management</h2>
    <div class="table-responsive">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>User</th>
                    <th>Check In</th>
                    <th>Check Out</th>
                    <th>Status</th>
                    <th>Total Price</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if (bookings && bookings.length > 0) { %>
                    <% bookings.forEach(booking => { %>
                        <tr>
                            <td><%= booking.booking_id %></td>
                            <td><%= booking.username %></td>
                            <td><%= booking.check_in ? booking.check_in.split('T')[0] : 'N/A' %></td>
                            <td><%= booking.check_out ? booking.check_out.split('T')[0] : 'N/A' %></td>
                            <td>
                                <span class="badge bg-secondary"><%= booking.status %></span>
                            </td>
                            <td><%= booking.total_price %></td>
                            <td>
                                <a href="/bookings/<%= booking.booking_id %>" class="btn btn-sm btn-info">Details</a>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr><td colspan="7">No bookings found.</td></tr>
                <% } %>
            </tbody>
        </table>
    </div>
<%- include('../footer') %>