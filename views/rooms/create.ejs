<%- include('../layout', { body: `
    <h2 class="mb-4">Create New Room</h2>
    <form action="/rooms" method="POST" class="card p-4">
        <div class="row">
            <div class="col-md-6 mb-3">
                <label>Room Number</label>
                <input type="text" name="room_number" class="form-control" required>
            </div>
            <div class="col-md-6 mb-3">
                <label>Room Type</label>
                <select name="room_type_id" class="form-control" required>
                    <% roomTypes.forEach(type => { %>
                        <option value="<%= type.room_type_id %>"><%= type.name %></option>
                    <% }) %>
                </select>
            </div>
            <div class="col-md-4 mb-3">
                <label>Floor</label>
                <input type="number" name="floor" class="form-control">
            </div>
            <div class="col-md-4 mb-3">
                <label>Price Per Night</label>
                <input type="number" name="price_per_night" class="form-control" required>
            </div>
            <div class="col-md-4 mb-3">
                <label>Max Guests</label>
                <input type="number" name="max_guests" class="form-control">
            </div>
            <div class="col-md-12 mb-3">
                <label>Description</label>
                <textarea name="description" class="form-control"></textarea>
            </div>
        </div>
        <button type="submit" class="btn btn-success">Save Room</button>
        <a href="/rooms" class="btn btn-secondary">Cancel</a>
    </form>
`}) %>